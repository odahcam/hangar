{
  "name": "hangar",
  "version": "0.3.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Catalog, prioritize and resume your Claude Code sessions on macOS and Windows.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "cargo run -q -p hangar-core --bin hangar-server",
    "app": "tauri dev",
    "build": "tauri build",
    "build:core": "cargo build -q -p hangar-core --bin hangar-server",
    "build:app": "cargo build -q -p hangar",
    "pretest": "npm run build:core",
    "test": "node --test test/*.test.js",
    "pretest:e2e": "npm run build:core",
    "test:e2e": "playwright test --project=web",
    "pretest:desktop": "npm run build:app",
    "test:desktop": "playwright test --project=desktop",
    "test:build": "node --test test-build/*.test.js",
    "test:all": "npm test && npm run test:e2e && npm run test:desktop && npm run test:build"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@tauri-apps/cli": "2.12.4"
  }
}
