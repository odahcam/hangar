{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hangar-relay",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"account_id": "986fa99c80ca3636b341894942fb9bfe",
	"workers_dev": false,
	"routes": [{ "pattern": "hangar.odahcam.com", "custom_domain": true }],
	// The landing page. Static asset requests don't run the Worker (nor count against its quota); /v1 always does.
	"assets": { "directory": "./public", "run_worker_first": ["/v1/*"] },
	// Logs keep request metadata only: the token travels in the Authorization header, never in the URL.
	"observability": { "enabled": true },
	"vars": {
		"ISSUER": "https://auth.odahcam.com",
		"AUDIENCE": "https://hangar.odahcam.com",
		"CLIENT_ID": "hangar",
		"JWKS": "https://auth.odahcam.com/api/auth/jwks"
	},
	// Secret (wrangler secret put): ALLOWED_SUBS, the account ids served (see auth.ts). Unset serves no one.
	// Connection attempts a minute (see index.ts). Counted per Cloudflare location, so a spread-out flood gets more.
	"ratelimits": [
		{ "name": "CONNECT_PER_IP", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
		{ "name": "CONNECT_PER_ACCOUNT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
	],
	"durable_objects": { "bindings": [{ "name": "ACCOUNT", "class_name": "Account" }] },
	// SQLite-backed: the only Durable Objects the Workers Free plan runs.
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }]
}
